# Copy to .env.local. Everything works out of the box with mocks — no keys required.

# Secret used to sign session cookies. Any long random string.
# Generate one: openssl rand -base64 32
BETTER_AUTH_SECRET=X6jdyLtJ6Kl+14ysmEgj33yRKlQsP04qIsNfHje4ATI=

# Canonical app URL (used for OAuth callbacks and email links).
BETTER_AUTH_URL=http://localhost:3000

# --- Google OAuth -------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Email / SMS -------------------------------------------------------------
# The prototype ships console transports only: verification links and OTP codes
# are printed to the `npm run dev` terminal. Swap in Resend/Twilio by
# implementing the Mailer/SmsSender interfaces in lib/notify.ts.

# --- Internal ----------------------------------------------------------------
# Set to 1 to enable the internal VIP-recruiting view at /admin/recruiting.
# (Internal tool, no auth polish — do not enable on a shared deployment.)
ADMIN_RECRUITING=1
